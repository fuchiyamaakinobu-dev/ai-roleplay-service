{
  "name": "ai-roleplay-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGIN": "https://fuchiyamaakinobu-dev.github.io",
    "LLM_ENABLED": "true"
  },
  "durable_objects": {
    "bindings": [{ "name": "BUDGET", "class_name": "RoleplayBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoleplayBudget"] }],
  "observability": { "enabled": false }
}
